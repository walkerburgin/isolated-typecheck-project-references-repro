{
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "target": "es2022",
    "jsx": "react",
    "module": "esnext",
    "rootDir": "src",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "isolatedModules": true,
    "isolatedDeclarations": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "plugins": [{ "name": "ts-bazel-plugin" }]
  },
  "include": ["src"],
  "references": [
    { "path": "../foo-lib" }
  ]
}
